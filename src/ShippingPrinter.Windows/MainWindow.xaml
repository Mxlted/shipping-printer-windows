<Window x:Class="ShippingPrinter.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Shipping Printer"
        Width="1360" Height="900" MinWidth="1080" MinHeight="740"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="Window_Drop" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Window.Resources>
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style x:Key="Divider" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource Line}"/><Setter Property="Margin" Value="0,20,0,0"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <!-- Compact application bar; the document is the primary visual. -->
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="22,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="30" Height="30" Background="{DynamicResource Accent}" CornerRadius="7" Margin="0,0,11,0">
      <Viewbox Width="18" Height="20"><Canvas Width="22" Height="24"><Path Data="M 4,2 L 14,2 L 19,7 L 19,22 L 3,22 L 3,2 Z M 14,2 L 14,7 L 19,7 M 6,10 L 13,10 M 6,14 L 6,19 M 9,14 L 9,19 M 12,14 L 12,19 M 16,14 L 16,19" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.4" StrokeLineJoin="Round"/></Canvas></Viewbox>
     </Border>
     <TextBlock Text="Shipping Printer" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="23,0"/>
     <TextBlock Text="Print workspace" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
    </StackPanel>
    <Button x:Name="ThemeButton" Grid.Column="1" Style="{StaticResource GhostButton}" Click="Theme_Click" Margin="0" Padding="10,7" VerticalAlignment="Center" AutomationProperties.Name="Switch appearance">
     <StackPanel Orientation="Horizontal"><TextBlock x:Name="ThemeGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE708;" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="ThemeLabel" Text="Appearance"/></StackPanel>
    </Button>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition/><ColumnDefinition Width="294"/></Grid.ColumnDefinitions>
   <!-- Label library with live page thumbnails. -->
   <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
    <DockPanel Margin="14,0">
     <StackPanel DockPanel.Dock="Top">
      <Grid Margin="8,24,8,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Labels" FontSize="20" FontWeight="SemiBold"/><Border Grid.Column="1" Background="{DynamicResource Selected}" CornerRadius="5" Padding="7,2" VerticalAlignment="Center"><TextBlock x:Name="CountText" Text="0" FontSize="11" Foreground="{DynamicResource Muted}"/></Border></Grid>
      <Button x:Name="ImportButton" AutomationProperties.Name="Import files" Click="Import_Click" Margin="2,0,2,8" Height="38" ToolTip="Import PDFs or images (Ctrl+O)">
       <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBlock Text="Import files"/><TextBlock Text="Ctrl O" FontSize="10" Foreground="{DynamicResource Muted}" Margin="30,0,0,0" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <Button x:Name="CreateBarcodeButton" AutomationProperties.Name="Create barcode" Style="{StaticResource GhostButton}" Click="Barcode_Click" Margin="2,0,2,20" HorizontalContentAlignment="Left" Padding="12,8"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xED14;" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Create barcode"/></StackPanel></Button>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="6,12,6,18">
      <Button x:Name="RemoveButton" Content="Remove selected" Style="{StaticResource GhostButton}" Click="Remove_Click" HorizontalContentAlignment="Left" Padding="8,8" Margin="-4,0,0,14"/>
      <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,14"/>
      <TextBlock Text="A workspace for this session" FontSize="11" Foreground="{DynamicResource Muted}"/>
      <TextBlock Text="Export edited labels to keep them." FontSize="11" Foreground="{DynamicResource Subtle}" TextWrapping="Wrap" Margin="0,5,0,0"/>
     </StackPanel>
     <Grid>
      <TextBlock Text="Your imported labels appear here." Margin="8,12" HorizontalAlignment="Left">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=ItemsList, Path=Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <ListBox x:Name="ItemsList" SelectionChanged="Items_SelectionChanged" AutomationProperties.Name="Labels" Padding="0">
       <ListBox.ItemTemplate><DataTemplate>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Background="White" BorderBrush="#D9D9D5" BorderThickness="1" CornerRadius="2" Width="42" Height="56" Padding="3"><Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
         <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/></StackPanel>
        </Grid>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </DockPanel>
   </Border>
   <!-- A quiet work surface and an independent editing strip. -->
   <Grid Grid.Column="1" Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition/><RowDefinition Height="66"/></Grid.RowDefinitions>
    <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="DocumentTitle" Text="Label preview" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DocumentDetail" Text="Select a label to preview its print layout" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <Button x:Name="ExportButton" Grid.Column="1" Content="Export  ↓" Click="Export_Click" Style="{StaticResource GhostButton}" Margin="16,0,0,0" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="1" Margin="16,0">
     <Border CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1">
      <Border.Background><DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute" Viewbox="0,0,20,20" ViewboxUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="{DynamicResource Canvas}" Geometry="M0,0 H20 V20 H0 Z"/><GeometryDrawing Brush="{DynamicResource GridDot}"><GeometryDrawing.Geometry><EllipseGeometry Center="10,10" RadiusX="0.65" RadiusY="0.65"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Border.Background>
     </Border>
     <Grid Margin="34,30,34,48">
      <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"><Image.Effect><DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.22"/></Image.Effect></Image>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350">
       <Grid Width="124" Height="142" Margin="0,0,0,24">
        <Border Width="84" Height="112" Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" RenderTransformOrigin="0.5,0.5" Margin="18,0,0,16"><Border.RenderTransform><RotateTransform Angle="9"/></Border.RenderTransform></Border>
        <Border Width="84" Height="112" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SelectionEdge}" BorderThickness="1" CornerRadius="5" RenderTransformOrigin="0.5,0.5" Margin="0,14,16,0"><Border.RenderTransform><RotateTransform Angle="-7"/></Border.RenderTransform><Canvas Margin="12,14"><Path Data="M0,0 H26 M0,7 H42 M0,24 H53" Stroke="{DynamicResource Muted}" StrokeThickness="2"/><Path Data="M0,48 V72 M4,48 V72 M10,48 V72 M13,48 V72 M20,48 V72 M27,48 V72 M31,48 V72 M37,48 V72 M43,48 V72 M47,48 V72 M53,48 V72" Stroke="{DynamicResource Text}" StrokeThickness="2"/></Canvas></Border>
       </Grid>
       <TextBlock Text="Add a label to begin" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
       <TextBlock Text="Drop a PDF or image into the workspace.&#x0a;Each page becomes a label, ready to print." Style="{StaticResource MutedText}" FontSize="13" TextAlignment="Center" Margin="0,12,0,22"/>
       <Button Content="Import files" Style="{StaticResource Primary}" Click="Import_Click" HorizontalAlignment="Center" Padding="24,10" Margin="0"/>
       <Button Content="Try an example label  →" Style="{StaticResource GhostButton}" Click="Example_Click" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12"/>
      </StackPanel>
     </Grid>
     <TextBlock x:Name="PreviewInfo" Text="PDF · PNG · JPG · TIFF" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,17"/>
    </Grid>
    <Grid Grid.Row="2" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="CropButton" AutomationProperties.Name="Crop label" Style="{StaticResource ToolbarButton}" Click="Crop_Click" ToolTip="Crop label"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A8;" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Crop"/></StackPanel></Button>
      <Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="4,0,8,0"/>
      <Button x:Name="RotateLeftButton" Content="&#xE7AD;" Style="{StaticResource IconButton}" Click="RotateLeft_Click" ToolTip="Rotate left" AutomationProperties.Name="Rotate left"><Button.LayoutTransform><ScaleTransform ScaleX="-1"/></Button.LayoutTransform></Button>
      <Button x:Name="RotateRightButton" Content="&#xE7AD;" Style="{StaticResource IconButton}" Click="RotateRight_Click" ToolTip="Rotate right" AutomationProperties.Name="Rotate right"/>
      <Button x:Name="ResetButton" Content="Reset" Style="{StaticResource ToolbarButton}" Click="Reset_Click" Margin="6,0,0,0"/>
     </StackPanel>
     <TextBlock Grid.Column="1" Text="Fit to view" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
    </Grid>
   </Grid>
   <!-- Settings and a pinned destination beside the print action. -->
   <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
    <DockPanel>
     <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="22,24,22,21"><TextBlock Text="Print settings" FontSize="16" FontWeight="SemiBold"/></Border>
     <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Panel}" Padding="20,17,20,20">
      <StackPanel>
       <TextBlock Text="Destination" Style="{StaticResource FieldLabel}"/>
       <Button x:Name="PrinterSetupButton" Click="PrinterSetup_Click" Style="{StaticResource GhostButton}" Padding="0,6" Margin="0,0,0,15" HorizontalContentAlignment="Stretch" ToolTip="Printer setup" AutomationProperties.Name="Printer setup">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE749;" FontSize="18" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock x:Name="PrinterNameText" Text="Windows printer" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PrintHint" Text="Choose in the print dialog" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="›" FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></Grid>
       </Button>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Copies" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CopiesBox" Height="42" TextAlignment="Center" LostFocus="Setting_Changed" AutomationProperties.Name="Copies"/></StackPanel>
        <Button x:Name="PrintButton" Grid.Column="2" Content="Print label" Style="{StaticResource Primary}" Height="42" VerticalAlignment="Bottom" Margin="0" Click="Print_Click" ToolTip="Print the selected label (Ctrl+P)"/>
       </Grid>
      </StackPanel>
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,0,22,20">
      <StackPanel>
       <TextBlock Text="Paper" Style="{StaticResource Section}" Margin="0,20,0,12"/>
       <ComboBox x:Name="PresetBox" SelectionChanged="Preset_Changed" AutomationProperties.Name="Paper preset"><ComboBoxItem Content="Shipping · 4 × 6 in"/><ComboBoxItem Content="Shipping · 100 × 150 mm"/><ComboBoxItem Content="Small · 50 × 30 mm"/><ComboBoxItem Content="Square · 100 × 100 mm"/><ComboBoxItem Content="Custom size"/></ComboBox>
       <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Width · mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WidthBox" LostFocus="Setting_Changed" AutomationProperties.Name="Width mm"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Height · mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HeightBox" LostFocus="Setting_Changed" AutomationProperties.Name="Height mm"/></StackPanel></Grid>
       <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Margin · mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MarginBox" LostFocus="Setting_Changed" AutomationProperties.Name="Margin mm"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Resolution" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="DpiBox" SelectionChanged="Setting_Changed" AutomationProperties.Name="Resolution"><ComboBoxItem Content="203 DPI"/><ComboBoxItem Content="300 DPI"/></ComboBox></StackPanel></Grid>
       <Border Style="{StaticResource Divider}"/>
       <TextBlock Text="Image" Style="{StaticResource Section}" Margin="0,18,0,6"/>
       <CheckBox x:Name="MonoBox" Content="Black and white" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
       <Grid Margin="0,14,0,0" IsEnabled="{Binding ElementName=MonoBox, Path=IsChecked}"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Black threshold" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="1" Text="{Binding ElementName=ThresholdSlider, Path=Value, StringFormat={}{0:0}}" FontSize="11" Foreground="{DynamicResource Muted}"/><Slider x:Name="ThresholdSlider" Grid.Row="1" Grid.ColumnSpan="2" Minimum="1" Maximum="254" Value="160" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Threshold_Changed" Margin="0,7,0,0" AutomationProperties.Name="Black threshold"/></Grid>
       <Button x:Name="ReadBarcodeButton" Content="Read barcode" Style="{StaticResource GhostButton}" Click="ReadBarcode_Click" HorizontalContentAlignment="Left" Padding="0,7" Margin="0,7,0,0" FontSize="12"/>
       <Border Style="{StaticResource Divider}" Margin="0,14,0,0"/>
       <Expander Header="Thermal options" Margin="0,17,0,0"><StackPanel Margin="0,14,0,0">
        <TextBlock Text="Settings for direct thermal printing. Offsets move the output on paper." Style="{StaticResource MutedText}" Margin="0,0,0,14"/>
        <TextBlock Text="Label gap · mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GapBox" LostFocus="Setting_Changed" AutomationProperties.Name="Gap mm"/>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Density · 1–15" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DensityBox" LostFocus="Setting_Changed" AutomationProperties.Name="Density"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Speed · 1–8" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SpeedBox" LostFocus="Setting_Changed" AutomationProperties.Name="Speed"/></StackPanel></Grid>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="X offset · mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OffsetXBox" LostFocus="Setting_Changed" AutomationProperties.Name="X offset mm"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Y offset · mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OffsetYBox" LostFocus="Setting_Changed" AutomationProperties.Name="Y offset mm"/></StackPanel></Grid>
       </StackPanel></Expander>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="22,0" Background="{DynamicResource Panel}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready to import" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Padding="10,2" Click="Cancel_Click" FontSize="11"/><TextBlock Text="Ctrl O  Import     /     Ctrl P  Print" Foreground="{DynamicResource Subtle}" FontSize="10" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel></Grid>
  </Border>
 </Grid>
</Window>
