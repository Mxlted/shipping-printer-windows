<Window x:Class="ShippingPrinter.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Shipping Printer" Width="1320" Height="880" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
   <DockPanel LastChildFill="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="38" Height="38" Background="{DynamicResource Accent}" CornerRadius="8" Margin="0,0,12,0"><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="M 5,2 L 16,2 L 20,6 L 20,22 L 4,22 L 4,2 Z" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.5" StrokeLineJoin="Round"/><Path Data="M 7,7 L 14,7 M 7,10 L 12,10 M 7,14 L 7,19 M 10,14 L 10,19 M 12,14 L 12,19 M 16,14 L 16,19" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.5"/></Canvas></Viewbox></Border><StackPanel><TextBlock Text="Shipping Printer" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Prepare. Preview. Print." Style="{StaticResource MutedText}"/></StackPanel></StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ThemeButton" Content="Dark mode" Click="Theme_Click"/><Button Content="Printer setup" Click="PrinterSetup_Click"/><Button Content="＋  Import files" Style="{StaticResource Primary}" Click="Import_Click" ToolTip="Import PDFs or images (Ctrl+O)"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="16,20,16,16">
    <DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="WORKSPACE" Style="{StaticResource Section}" Margin="5,0,0,14"/><TextBlock x:Name="CountText" Text="0 labels" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></DockPanel><Button Content="＋  Create barcode" Click="Barcode_Click" Margin="0,0,0,12" HorizontalContentAlignment="Left"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><Button x:Name="RemoveButton" Content="Remove selected" Click="Remove_Click" Margin="0,12,0,10"/><TextBlock Text="Drop PDFs and images here. Each PDF page becomes a label." Style="{StaticResource MutedText}" Margin="4,0"/></StackPanel>
     <ListBox x:Name="ItemsList" SelectionChanged="Items_SelectionChanged" AutomationProperties.Name="Labels"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
    <DockPanel Margin="22,16" LastChildFill="False"><StackPanel Orientation="Horizontal"><Button x:Name="CropButton" Content="Crop" Click="Crop_Click"/><Button x:Name="RotateLeftButton" Content="↶" Click="RotateLeft_Click" ToolTip="Rotate left" AutomationProperties.Name="Rotate left"/><Button x:Name="RotateRightButton" Content="↷" Click="RotateRight_Click" ToolTip="Rotate right" AutomationProperties.Name="Rotate right"/><Button x:Name="ResetButton" Content="Reset" Click="Reset_Click"/></StackPanel><Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Export ▾" Click="Export_Click" Margin="0"/></DockPanel>
    <Grid Grid.Row="1" Margin="30,12,30,8">
     <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"><Image.Effect><DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="3" Opacity="0.15"/></Image.Effect></Image>
     <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="370"><TextBlock Text="Ready for your first label" FontSize="27" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Open a PDF or image, drop a file here, or create a barcode." Style="{StaticResource MutedText}" FontSize="14" TextAlignment="Center" Margin="0,16,0,24"/><Button Content="Import a PDF or image" Style="{StaticResource Primary}" Click="Import_Click" HorizontalAlignment="Center"/><Button Content="Try an example label" Click="Example_Click" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
    </Grid>
    <TextBlock x:Name="PreviewInfo" Grid.Row="2" Text="Actual label proportions · Fit to view" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>
   <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
    <DockPanel Margin="20,20,20,18">
     <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Button x:Name="PrintButton" Content="Print label" Style="{StaticResource Primary}" Margin="0" Padding="16,13" Click="Print_Click" ToolTip="Print the selected label (Ctrl+P)"/><TextBlock x:Name="PrintHint" Text="Review the printer dialog before printing." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,9,0,0"/></StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,7,0">
      <TextBlock Text="Label settings" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="PAPER" Style="{StaticResource Section}"/>
      <ComboBox x:Name="PresetBox" SelectionChanged="Preset_Changed" AutomationProperties.Name="Paper preset"><ComboBoxItem Content="Shipping · 4 × 6 in"/><ComboBoxItem Content="Shipping · 100 × 150 mm"/><ComboBoxItem Content="Small · 50 × 30 mm"/><ComboBoxItem Content="Square · 100 × 100 mm"/><ComboBoxItem Content="Custom size"/></ComboBox>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Width (mm)" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox x:Name="WidthBox" LostFocus="Setting_Changed" AutomationProperties.Name="Width mm"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Height (mm)" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox x:Name="HeightBox" LostFocus="Setting_Changed" AutomationProperties.Name="Height mm"/></StackPanel></Grid>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Margin (mm)" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox x:Name="MarginBox" LostFocus="Setting_Changed" AutomationProperties.Name="Margin mm"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Resolution" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><ComboBox x:Name="DpiBox" SelectionChanged="Setting_Changed" AutomationProperties.Name="Resolution"><ComboBoxItem Content="203 DPI"/><ComboBoxItem Content="300 DPI"/></ComboBox></StackPanel></Grid>
      <TextBlock Text="OUTPUT" Style="{StaticResource Section}"/>
      <CheckBox x:Name="MonoBox" Content="Black and white" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
      <DockPanel Margin="0,9,0,0"><TextBlock Text="Black threshold" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ElementName=ThresholdSlider, Path=Value, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="ThresholdSlider" Minimum="1" Maximum="254" Value="160" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Threshold_Changed" Margin="0,8,0,0" AutomationProperties.Name="Black threshold"/>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Copies" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox x:Name="CopiesBox" LostFocus="Setting_Changed" AutomationProperties.Name="Copies"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Gap (mm)" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox x:Name="GapBox" LostFocus="Setting_Changed" AutomationProperties.Name="Gap mm"/></StackPanel></Grid>
      <Expander Header="Thermal printer options" Margin="0,20,0,0" Foreground="{DynamicResource Text}"><StackPanel Margin="0,10,0,0"><TextBlock Text="Density and speed affect direct TSPL. Offsets shift printed output only; the preview stays centered." Style="{StaticResource MutedText}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Density · 1–15" Style="{StaticResource MutedText}"/><TextBox x:Name="DensityBox" LostFocus="Setting_Changed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Speed · 1–8" Style="{StaticResource MutedText}"/><TextBox x:Name="SpeedBox" LostFocus="Setting_Changed"/></StackPanel></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="X offset (mm)" Style="{StaticResource MutedText}"/><TextBox x:Name="OffsetXBox" LostFocus="Setting_Changed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Y offset (mm)" Style="{StaticResource MutedText}"/><TextBox x:Name="OffsetYBox" LostFocus="Setting_Changed"/></StackPanel></Grid></StackPanel></Expander>
      <Button x:Name="ReadBarcodeButton" Content="Read barcode from label" Click="ReadBarcode_Click" Margin="0,20,0,0"/>
     </StackPanel></ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,0"><DockPanel><TextBlock x:Name="StatusText" Text="Ready. Import a label to get started." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Visibility="Collapsed" Padding="10,3" Click="Cancel_Click"/><TextBlock DockPanel.Dock="Right" Text="WINDOWS EDITION" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/></DockPanel></Border>
 </Grid>
</Window>
